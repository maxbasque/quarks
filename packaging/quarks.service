[Unit]
Description=Quark's — personal feed dashboard
Documentation=https://github.com/maxbasque/quarks
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/quarks
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
