[Desktop Entry]
Type=Application
Name=Quark's
GenericName=Feed dashboard
Comment=Your feeds on one screen
Exec=quarks-open
Icon=quarks
Terminal=false
Categories=Network;News;
Keywords=feed;dashboard;rss;news;

# quarks-window sets its program name to "quarks" (the Wayland app_id / X11
# WM_CLASS), which is how the taskbar matches the window to this entry.
StartupWMClass=quarks
