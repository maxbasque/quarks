[Desktop Entry]
Type=Application
Name=Quark's
GenericName=Feed dashboard
Comment=Your feeds on one screen
Exec=quarks-open
Icon=quarks
Terminal=false
Categories=Network;News;
Keywords=feed;dashboard;rss;news;

# Chromium's window id for `--app=http://localhost…` (verified on KDE Wayland,
# Chrome flatpak — the port is not part of the id). If a Chromium build reports
# something else and the taskbar shows a generic icon, open the dashboard and use
# Chrome's "Install Quark's…", which writes its own correct entry.
StartupWMClass=chrome-localhost__-Default
