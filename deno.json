{
  "tasks": {
    "build": "make build",
    "run": "deno run --allow-all cmd/quarks.ts",
    "dev": "deno run --allow-all cmd/quarks.ts --config config.fake.yaml",
    "fakefeed": "deno run --allow-net cmd/fakefeed.ts",
    "test": "deno test --allow-all",
    "check": "deno check cmd/ src/ && deno lint"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/path": "jsr:@std/path@^1.1.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.0",
    "@std/cli": "jsr:@std/cli@^1.0.0",
    "@mozilla/readability": "npm:@mozilla/readability@^0.6.0",
    "entities": "npm:entities@^6.0.0",
    "fast-xml-parser": "npm:fast-xml-parser@^5.2.0",
    "linkedom": "npm:linkedom@^0.18.0",
    "sanitize-html": "npm:sanitize-html@^2.17.0",
    "yaml": "npm:yaml@^2.8.0"
  },
  "compilerOptions": {
    "strict": true
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any"
      ]
    },
    "exclude": [
      "src/web/static/"
    ]
  },
  "fmt": {
    "lineWidth": 120,
    "exclude": [
      "src/web/static/",
      "**/*.md",
      "**/*.yaml",
      "**/*.yml"
    ]
  },
  "exclude": [
    "dist/"
  ]
}
